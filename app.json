{
  "expo": {
    "name": "Paperly",
    "slug": "orun-note",
    "version": "1.6.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "orunnote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E7C7B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paperly.study",
      "requireFullScreen": false,
      "infoPlist": {
        "CFBundleDisplayName": "옳은Note",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false,
        "NSMicrophoneUsageDescription": "홈워크(숙제)의 녹음 과제를 제출할 때 마이크를 사용합니다.",
        "NSCameraUsageDescription": "홈워크에서 숙제 사진을 찍어 제출하거나 필기에 사진을 넣을 때 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "필기에 사진을 넣거나 홈워크에 사진을 제출할 때 사진 보관함을 사용합니다."
      }
    },
    "android": {
      "package": "com.paperly.study",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF2FC"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "옳은Note",
      "shortName": "옳은Note"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EAF2FC",
          "imageWidth": 220
        }
      ],
      "expo-document-picker",
      [
        "./plugins/withAppDisplayName.js",
        {
          "name": "옳은Note"
        }
      ],
      "expo-web-browser",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "필기에 사진을 넣거나 홈워크에 사진을 제출할 때 사진 보관함을 사용합니다.",
          "cameraPermission": "홈워크에서 숙제 사진을 찍어 제출할 때 카메라를 사용합니다.",
          "microphonePermission": "홈워크(숙제)의 녹음 과제를 제출할 때 마이크를 사용합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}