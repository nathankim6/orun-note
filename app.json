{
  "expo": {
    "name": "Paperly",
    "slug": "orun-note",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "orunnote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E7C7B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paperly.study",
      "requireFullScreen": false,
      "infoPlist": {
        "CFBundleDisplayName": "옳은Note",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "com.paperly.study",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF2FC"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "옳은Note",
      "shortName": "옳은Note"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EAF2FC",
          "imageWidth": 220
        }
      ],
      "expo-document-picker",
      [
        "./plugins/withAppDisplayName.js",
        {
          "name": "옳은Note"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}